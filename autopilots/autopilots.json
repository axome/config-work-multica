[
  {
    "title": "Récap du temps RUN (chronomètre Monday)",
    "mode": "run_only",
    "issue_title_template": "Temps RUN du {{date}}",
    "status": "active",
    "agent": "importeur",
    "prompt": "autopilots/recap-du-temps-run-chronometre.md",
    "triggers": [
      {
        "kind": "schedule",
        "cron": "0 18 * * 1-5",
        "timezone": "Europe/Paris",
        "label": "18 h en semaine"
      }
    ]
  },
  {
    "title": "Rapport hebdomadaire (consommation et cohérence)",
