    "issue_title_template": "Consommation multica semaine du {{date}}",
    "status": "active",
    "agent": "importeur",
    "prompt": "autopilots/rapport-hebdomadaire-consommation-et-coherence.md",
    "triggers": [
      {
        "kind": "schedule",
        "cron": "0 8 * * 1",
        "timezone": "Europe/Paris",
        "label": "Lundi 8 h"
      }
    ]
  },
  {
    "title": "Import des tickets du jour (BUILD et RUN)",
    "mode": "run_only",
    "status": "active",
